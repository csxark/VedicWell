# ==============================================================================
# Frontend Environment Variables (Vite)
# ==============================================================================

# Supabase project URL — get from: Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/publishable key — safe to expose to the browser
# Get from: Project Settings → API → Project API keys → anon public
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Railway FastAPI service public HTTPS URL
# Set this after deploying the backend/main.py service
# Example: VITE_DOSHA_API_URL=https://your-railway-service.railway.app
# Leave empty to use local Ayurvedic scoring fallback only
VITE_DOSHA_API_URL=http://localhost:8000

# Cloudflare Turnstile CAPTCHA (Optional / Anti-Abuse)
# If provided, renders Turnstile verification widget on Auth forms
VITE_TURNSTILE_SITE_KEY=

# Feature Flag: Deferred Email Verification
# Set to 'false' to allow unverified users to sign in and take assessments immediately
# Set to 'true' to gate dashboard access behind confirmed email
VITE_REQUIRE_EMAIL_VERIFICATION=false

# ==============================================================================
# Backend Environment Variables (FastAPI - backend/)
# ==============================================================================

# Supabase Admin / Service Role Credentials
# Used by backend to verify user JWTs and fetch latest assessments
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct PostgreSQL connection string for auto-migration runner (Optional)
# Example: postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Admin endpoint secret protection for /run-migrations and /db-status
ADMIN_SECRET=your-secure-random-admin-secret

# Email Verification Gate (Backend)
# When 'false' (default), users can use authenticated endpoints without email confirmation
# When 'true', endpoints reject unverified users with HTTP 403
REQUIRE_EMAIL_VERIFICATION=false

# CORS Allowed Origins (comma-separated list of origins)
# Example: http://localhost:5173,https://vedicwell.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting Configurations (slowapi)
# Default limits: /predict is 30/minute, authenticated endpoints are 60/minute
RATE_LIMIT_PREDICT=30/minute
RATE_LIMIT_USER_ENDPOINTS=60/minute

# ML Model Artifact Path (defaults to dosha_model.pkl in backend/)
MODEL_PATH=dosha_model.pkl

# Cloudflare Turnstile Server Secret (Optional)
TURNSTILE_SECRET_KEY=

# ==============================================================================
# Supabase Edge Functions Environment Secrets (supabase/functions/)
# Set via: supabase secrets set KEY=VALUE
# ==============================================================================

# AI Gateway API Key for symptom-checker Edge Function
LOVABLE_API_KEY=your-lovable-or-gemini-api-key

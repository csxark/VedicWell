# Path to the trained model file (relative to the backend directory)
MODEL_PATH=dosha_model.pkl

# Railway assigns this automatically — do not set manually in Railway
PORT=8000

# Supabase project URL — required for /current-dosha and /recommendations endpoints
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Service Role Key — server-side only, NEVER expose to frontend
# Required for /current-dosha and /recommendations to query user assessments
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated list of allowed frontend origins for CORS
# Use * during development; set to your actual domain in production
# Example: https://yourapp.vercel.app,https://yourapp.netlify.app
ALLOWED_ORIGINS=*

# Optional: Direct PostgreSQL connection string for automated table checks and migrations
# If set, the backend automatically runs pending migrations on startup so all tables exist.
# Format: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:your-db-password@your-db-host:5432/postgres

# Admin Secret — required for /db-status and /run-migrations endpoints
# (Falls back to SUPABASE_SERVICE_ROLE_KEY if not explicitly set)
ADMIN_SECRET=your-secure-admin-secret
